# Application Settings
APP_NAME=PostPilot
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./social_media.db

# AWS Configuration (all in ca-central-1)
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_REGION=ca-central-1

# Claude (Bedrock)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Bria Image Generation (SageMaker Marketplace)
BEDROCK_IMAGE_MODEL_ID=bria-ai-2-3-fast-commercial
SAGEMAKER_ENDPOINT_NAME=

# Note: SAGEMAKER_ENDPOINT_NAME will be blank until you deploy the Bria model.
# See SETUP.md for deployment instructions.

# Scheduler (lightweight - on-demand generation)
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Africa/Johannesburg

# Content Generation
DEFAULT_LANGUAGE=en
MAX_HASHTAGS_PER_POST=30
CONTENT_CACHE_TTL=3600

# Image Generation
DEFAULT_FONT=arial
IMAGE_QUALITY=95

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
